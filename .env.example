# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Connection string for your Atlas cluster (see README "MongoDB Atlas Setup").
# Never commit a real URI — it contains a username/password.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=docchat

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
# This project expects Ollama running on your HOST machine (not as a Docker
# Compose service) — install it from https://ollama.com and run `ollama pull
# <model>` there directly.
#
# OLLAMA_BASE_URL is left unset here on purpose:
#   - Running the backend directly on the host (no Docker): it defaults to
#     http://localhost:11434, which is correct as-is.
#   - Running via `docker compose up`: docker-compose.yml supplies its own
#     default of http://host.docker.internal:11434 so the container can
#     reach your host's Ollama. If you set OLLAMA_BASE_URL here, it
#     overrides that Docker default too — only uncomment it if you have a
#     reason to (e.g. Ollama running somewhere other than localhost).
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG pipeline ─────────────────────────────────────────────────────────────
TOP_K=5
NUM_CANDIDATES=50
MIN_RELEVANCE_SCORE=0.50
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_HISTORY_MESSAGES=10
VECTOR_INDEX_NAME=vector_index

# Show retrieved chunks (with scores) in API responses for demo/debugging.
DEBUG_RAG=false

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
# A relative path here always resolves against the repo root (not the
# process's working directory), so this is safe regardless of whether you
# run the backend from the repo root or from backend/. Use an absolute path
# to store uploads somewhere else entirely (Docker sets one automatically).
STORAGE_PATH=./storage/documents

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_FORMAT=text is readable in a local terminal; LOG_FORMAT=json emits one
# JSON object per line (with document_id, chunks, etc. as real fields, not
# baked into the message text) for a production log aggregator to query.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Frontend ─────────────────────────────────────────────────────────────────
# Consumed by the Vite frontend (frontend/.env.example) — repeated here so a
# single `docker compose up` has everything it needs via one root .env file.
VITE_API_BASE_URL=http://localhost:8000/api
